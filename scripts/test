#!/bin/sh
# Runs this repository's bounded test gate. Exits nonzero on any failure.
# Needs: python3 (>=3.11), curl, and network (dependency install only; no
# oracle checkout). Everything installs under the temp dir; no pre-existing
# sibling checkout is required. This is the push gate: the same selection CI's
# push job runs (pytest -m "not slow and not oracle"). CI's scheduled and
# workflow_dispatch jobs run the full oracle suite directly from .github/workflows/tests.yml,
# reading the pinned oracle revision from CPU_PINNED_REVISION/CPU_PINNED_TREE
# below; the whole-catalog scripts/parity-summary runs there and as the
# reviewer's own pre-review parity check. The full suite plus the summary
# exceed any single bounded invocation, so they never run inside this gate.
set -eu
cd "$(dirname "$0")/.."
VENV="${TMPDIR:-/tmp}/noisemaker-py-test-venv"
if [ ! -x "$VENV/bin/python" ]; then
    # Some minimal distros ship python3 without ensurepip (no python3-venv
    # package); create the venv without pip and bootstrap pip from the network.
    python3 -m venv --without-pip "$VENV"
    curl -fsSL https://bootstrap.pypa.io/get-pip.py -o "$VENV/get-pip.py"
    "$VENV/bin/python" "$VENV/get-pip.py" >/dev/null
    rm -f "$VENV/get-pip.py"
fi
"$VENV/bin/pip" install -q -e '.[dev,build]'

# The pinned current-authority oracle: noisemaker-for-cpu at CPU_PINNED_REVISION
# (CI reads the pin from here for its weekly full-suite gate and the parity
# summary; this quick gate does not run the oracle itself).
CPU_PINNED_REVISION=db42f30c5c3ab711362bf5dbd4013b16637b48f5
CPU_PINNED_TREE=ea91fb76de96f347ed653383e2277b121a334fad

# Changed-files selection (operator rule): when the supervisor passes this
# candidate's changed paths in NM_CHANGED_FILES (one per line), run only the
# test files that exercise them. A test file is selected when its text names
# any changed path's basename or its bundle-kernel basename, so kernel,
# transpiler, and runtime changes each select their covering tests. With the
# variable unset, the whole suite runs exactly as before.
if [ -n "${NM_CHANGED_FILES:-}" ]; then
    select_tests() {
        "$VENV/bin/python" - "$NM_CHANGED_FILES" <<-'PY'
			import pathlib, sys
			changed = [line.strip() for line in sys.argv[1].splitlines() if line.strip()]
			names = set()
			for path in changed:
			    path = path.rstrip("/")
			    names.add(path)
			    base = path.rsplit("/", 1)[-1]
			    stem = base[: -len(".py")] if base.endswith(".py") else base
			    names.update({base, stem, stem.replace("__", "/")})
			selected = []
			for test in sorted(pathlib.Path("tests").glob("test_*.py")):
			    text = test.read_text(encoding="utf-8", errors="replace")
			    if any(name and name in text for name in names):
			        selected.append(str(test))
			print(" ".join(selected))
		PY
    }
    SELECTION=$(select_tests)
    if [ -n "$SELECTION" ]; then
        echo "NM_CHANGED_FILES selection: $SELECTION"
        exec "$VENV/bin/python" -m pytest -q -m "not slow and not oracle" $SELECTION
    fi
fi

"$VENV/bin/python" -m pytest -q -m "not slow and not oracle"
