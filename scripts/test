#!/bin/sh
# Runs this repository's test suite. Exits nonzero on any failure.
# Needs: python3 (>=3.11), curl, git, node, and network (dependency install and
# the pinned oracle below). Everything installs under the temp dir; no
# pre-existing sibling checkout is required. This is the full gate: CI runs it
# weekly; pushes run the quick subset (pytest -m "not slow and not oracle").
set -eu
cd "$(dirname "$0")/.."
VENV="${TMPDIR:-/tmp}/noisemaker-py-test-venv"
if [ ! -x "$VENV/bin/python" ]; then
    # Some minimal distros ship python3 without ensurepip (no python3-venv
    # package); create the venv without pip and bootstrap pip from the network.
    python3 -m venv --without-pip "$VENV"
    curl -fsSL https://bootstrap.pypa.io/get-pip.py -o "$VENV/get-pip.py"
    "$VENV/bin/python" "$VENV/get-pip.py" >/dev/null
    rm -f "$VENV/get-pip.py"
fi
"$VENV/bin/pip" install -q -e '.[dev,build]'

# The pinned current-authority oracle: noisemaker-for-cpu at CPU_PINNED_REVISION
# (CI reads the pin from here too). With node, clone/refresh it, run the whole
# suite against it, then run scripts/parity-summary: every bundled effect id must
# render byte-identically to the oracle (exit 0 required; the printed
# PARITY-SUMMARY line binds the run to both revisions). Without node the oracle
# cannot run, so only the node-free tests run.
if command -v node >/dev/null 2>&1; then
    CPU_PINNED_REVISION=a1a129a63ca16bcaf19699f793f33b6159312228
    CPU_PINNED_TREE=fa46020cff37b4b6d60c9f9ebb4b29e334c052b5
    CPU_DIR="${TMPDIR:-/tmp}/noisemaker-py-cpu-oracle"
    if [ ! -d "$CPU_DIR/.git" ]; then
        git clone -q https://github.com/noisefactorllc/noisemaker-for-cpu.git "$CPU_DIR"
    fi
    git -C "$CPU_DIR" fetch -q origin "$CPU_PINNED_REVISION"
    git -C "$CPU_DIR" checkout -q --detach "$CPU_PINNED_REVISION"
    ACTUAL_TREE=$(git -C "$CPU_DIR" rev-parse 'HEAD^{tree}')
    if [ "$ACTUAL_TREE" != "$CPU_PINNED_TREE" ]; then
        echo "cpu oracle tree mismatch at $CPU_PINNED_REVISION: $ACTUAL_TREE" >&2
        exit 1
    fi
    NOISEMAKER_CPU_DIR="$CPU_DIR" "$VENV/bin/python" -m pytest -q
    # The parity summary's log is the release evidence: run the summary, keep
    # its output, and audit the log with the release gate (the port declares no
    # skips and no accepted failures, so both declarations are empty).
    PARITY_LOG="${TMPDIR:-/tmp}/noisemaker-py-parity-summary.log"
    if ! NOISEMAKER_CPU_DIR="$CPU_DIR" "$VENV/bin/python" scripts/parity-summary >"$PARITY_LOG"; then
        cat "$PARITY_LOG"
        exit 1
    fi
    cat "$PARITY_LOG"
    "$VENV/bin/python" scripts/parity/release_gate.py "$PARITY_LOG" --declared-skips '' --accepted-failures ''
else
    "$VENV/bin/python" -m pytest -q -m "not oracle"
fi
