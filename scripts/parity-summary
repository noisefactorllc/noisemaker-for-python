#!/usr/bin/env python
"""Whole-catalog parity gate: render every bundled effect with this port,
compare each with the pinned noisemaker-for-cpu authority oracle, and print a
machine-readable PARITY-SUMMARY line as the last output.

Every case is reported on its own verdict line — `EXACT <id>` or
`FAIL <id> (reason)` — in the same grammar as the oracle's parity summary, so
scripts/parity/release_gate.py can audit the logged run against the release
declarations.

Usage: scripts/parity-summary [case_id ...]

Coverage contract: every bundled effect id (the authority catalog) must be
executed and byte-identical to the oracle at the port's published numerical
contract (byte-exact, zero tolerance). Plain effects render through the
`effect` CLI path; iterated/typed-chain/volume/loop effects render through the
DSL programs shared with tests/test_parity.py (ITERATED_PROGRAMS and
VOLUME_DSL_CASES) — the same programs, sizes, seed, and time the test suite
verifies byte-exactly. An effect with no executable case counts as missing, so
incomplete coverage fails (nonzero exit) instead of being silently skipped.

The authority oracle is the sibling noisemaker-for-cpu checkout at
NOISEMAKER_CPU_DIR (default: ../../noisemaker-for-cpu).

Exit code is 0 only when expected > 0, executed == expected,
exact + strict == expected, and near, defer, skip, fail, and missing are all
zero. With case-id arguments only those effects are rendered and counted.
"""

from __future__ import annotations

import importlib.util
import os
import sys

_HERE = os.path.dirname(os.path.abspath(__file__))
_ROOT = os.path.dirname(_HERE)

_spec = importlib.util.spec_from_file_location("_noisemaker_parity", os.path.join(_HERE, "parity.py"))
_parity = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(_parity)

sys.modules.setdefault("tests", importlib.util.module_from_spec(importlib.util.spec_from_loader("tests", None)))
_tpspec = importlib.util.spec_from_file_location("tests.test_parity", os.path.join(_ROOT, "tests", "test_parity.py"))
_tp = importlib.util.module_from_spec(_tpspec)
sys.modules["tests.test_parity"] = _tp
_tpspec.loader.exec_module(_tp)

import numpy as np  # noqa: E402


def _build_cases(effects: dict) -> dict:
    """Map every bundled effect id to one executable oracle-comparison case."""
    cases: dict = {}
    for eid, spec in effects.items():
        if eid in _parity.EXTERNAL_INPUT_EFFECT_IDS:
            cases[eid] = ("external", eid, _parity.SIZE)
        elif not (spec.get("iterated") or spec.get("domain", "image") != "image"):
            cases[eid] = ("effect", eid, _parity.SIZE)
    for eid, program in _tp.ITERATED_PROGRAMS.items():
        base = eid.split(":")[0]
        if base in effects and base not in _parity.EXTERNAL_INPUT_EFFECT_IDS:
            # The declared chain is the executable case. It overrides the
            # default single-effect case for non-iterated image effects whose
            # default render never exercises the behavior the chain pins
            # (points/heightGrid's passthrough never reads its agent's outXYZ;
            # filter/flipMirror renders a solid input, which every mirror mode
            # maps onto itself).
            cases[base] = ("dsl", program, 8)
    for eid, (program, width) in getattr(_tp, "WIDE_IMAGE_CHAINS", {}).items():
        base = eid.split(":")[0]
        if base in effects and base not in _parity.EXTERNAL_INPUT_EFFECT_IDS:
            # Declared chain at its own width, same override rule as above
            # (filter/glyphMap draws no glyphs over the solid default input).
            cases[base] = ("dsl", program, width)
    for case_id, program, width, _height in _tp.VOLUME_DSL_CASES:
        base = case_id.split(":")[0]
        if base in effects:
            cases.setdefault(base, ("dsl", program, width))
    return cases


def main() -> int:
    requested = [a for a in sys.argv[1:] if not a.startswith("-")]
    if any(a.startswith("-") for a in sys.argv[1:]):
        print("usage: scripts/parity-summary [case_id ...]", file=sys.stderr)
        return 2

    effects = _parity._meta()["effects"]
    cases = _build_cases(effects)

    if requested:
        unknown = [i for i in requested if i not in effects]
        if unknown:
            print(f"UNKNOWN EFFECTS: {sorted(unknown)}")
        selected = [i for i in effects if i in set(requested)]
        expected = len(requested)
    else:
        selected = list(effects)
        expected = len(effects)

    exact: list[str] = []
    fail = 0
    for eid in selected:
        case = cases.get(eid)
        if case is None:
            fail += 1
            print(f"FAIL {eid} (no-parity-case)")
            continue
        try:
            if case[0] == "effect":
                kind = effects[eid]["kind"]
                ext = effects[eid].get("externalTexture")
                input_png = _parity._ext_texture() and _parity.EXT_PNG if ext else None
                js = _parity.js_effect(eid, _parity.JS_PNG, input_png)
                py = _parity.py_render(eid, kind, ext)
            elif case[0] == "external":
                _, case_id, width = case
                js = _parity.js_effect_external(case_id, _parity.JS_PNG, width=width)
                from noisemaker_cpu.renderer import render_dsl

                py = render_dsl(
                    _parity._external_case_dsl(case_id),
                    width=width,
                    height=width,
                    seed=_parity.SEED,
                    time=_parity.TIME,
                    external_inputs=_parity.external_inputs_for_case(case_id),
                )
            else:
                _, program, width = case
                if effects[eid].get("externalTexture"):
                    raise RuntimeError("external-texture effect needs an effect-path case")
                js = _tp._js_render_dsl(program, _parity.JS_PNG, width=width, height=width, seed=_parity.SEED, time=_parity.TIME)
                from noisemaker_cpu.renderer import render_dsl

                py = render_dsl(program, width=width, height=width, seed=_parity.SEED, time=_parity.TIME)
        except Exception as e:
            fail += 1
            print(f"FAIL {eid} ({type(e).__name__}: {str(e).splitlines()[0][:90]})")
            continue
        ja = np.frombuffer(js.to_rgba8(), np.uint8).astype(int)
        pa = np.frombuffer(py.to_rgba8(), np.uint8).astype(int)
        if ja.shape != pa.shape:
            fail += 1
            print(f"FAIL {eid} (shape-mismatch)")
            continue
        d = int(np.max(np.abs(ja - pa)))
        if d == 0:
            exact.append(eid)
            print(f"EXACT {eid}")
        else:
            fail += 1
            print(f"FAIL {eid} (max-diff {d})")

    executed = len(exact)
    strict = 0
    near = 0
    defer = 0
    skip = 0
    missing = max(0, expected - executed - fail)
    import subprocess

    head = subprocess.run(["git", "rev-parse", "HEAD"], cwd=_ROOT, capture_output=True, text=True)
    tree = subprocess.run(["git", "rev-parse", "HEAD^{tree}"], cwd=_ROOT, capture_output=True, text=True)
    cpu = _parity._cpu_revision()
    print(
        "parity-summary provenance: portHead=%s portTree=%s cpuHead=%s cpuTree=%s upstreamPin=%s sourceDigest=%s"
        % (
            head.stdout.strip() if head.returncode == 0 else "unknown",
            tree.stdout.strip() if tree.returncode == 0 else "unknown",
            cpu.get("cpuHead") or "unknown",
            cpu.get("cpuTree") or "unknown",
            cpu.get("revision") or "unknown",
            cpu.get("sourceDigest") or "unknown",
        )
    )
    print(
        'PARITY-SUMMARY {"expected":%d,"executed":%d,"exact":%d,"strict":%d,'
        '"near":%d,"defer":%d,"skip":%d,"fail":%d,"missing":%d}'
        % (expected, executed, len(exact), strict, near, defer, skip, fail, missing)
    )
    complete = (
        expected > 0
        and executed == expected
        and len(exact) + strict == expected
        and not (near or defer or skip or fail or missing)
    )
    return 0 if complete else 1


if __name__ == "__main__":
    sys.exit(main())
